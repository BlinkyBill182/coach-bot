# Telegram bot token from @BotFather
TELEGRAM_TOKEN=
# Your Telegram user id (send /start to the bot; it replies with the number)
OWNER_ID=
# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=
# Public HTTPS address of the tracker Mini App, e.g. https://srv123456.hstgr.cloud/
WEB_URL=
# Optional: a long random string to open the tracker in a normal browser with ?key=...
WEB_KEY=
DB_PATH=/docker/coach/data/coach.db
GOOGLE_TOKEN=/docker/coach/data/google_token.json
GOOGLE_SERVICE_ACCOUNT=/docker/coach/data/google_service_account.json
SKILL_PATH=/app/skill/muscle-coach/SKILL.md
TRACKER_PATH=/docker/coach/tracker.html
PORT=8080
# Optional: ElevenLabs key for voice messages (speech to text)
ELEVENLABS_API_KEY=
# Optional: live drive times, from a service of your own that answers the API in coach/eta.py. Off without ETA_KEY.
ETA_URL=
ETA_KEY=
# Optional: restaurant suggestions from Wolt's public web endpoints. Unofficial, so they may change or stop. Off unless 1.
WOLT_ENABLED=
# Where the Wolt search starts when you haven't shared a location
HOME_ADDRESS=
# Words that hide a dish in Wolt menus, comma separated
FOOD_AVOID_WORDS=
# Optional: Google Calendar through a service account. The calendar you shared with it, usually your Gmail address
GOOGLE_CALENDAR_ID=
# The name of your gym, as it should appear in plans and calendar events
GYM_NAME=
# Optional: shown on the /privacy page, in case Google asks for it
CONTACT_EMAIL=
